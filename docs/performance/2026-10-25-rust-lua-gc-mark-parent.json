  "source": "local function one()collectgarbage('stop');local roots={};local weak=setmetatable({},{__mode='v'});for i=1,512 do roots[i]={i};weak[i]={i}end;collectgarbage('step',0);for i=1,512 do local v=weak[i] or{i};roots[i].child=v;if i%8==0 then collectgarbage('step',0)end end;collectgarbage();local n=0;for i=1,512 do n=n+roots[i].child[1]end;return n end;local n=0;for i=1,100 do n=n+one()end;print(n)",
