+#[test]
+fn native_mesh_publication_matches_frozen_topologies_and_reuses_snapshots() {
+    let lua = Lua::new();
+    for count in (0..17).chain([257]) {
+        let a = actor(&lua, count, None, false);
+        let mut cache = ActorMultiVertexMeshCache::default();
+        for mode in ["DrawMode_Triangles", "dRaWmOdE_QuAdS", "DrawMode_QuadStrip",
+                     "DrawMode_LineStrip", "DrawMode_Fan", "unknown"] {
+            for (first, num) in [(1, -1), (2, 7), (0, 0), (999, 3), (-8, 4)] {
+                for width in [0.0, -0.0, 1.25, f32::NAN, f32::INFINITY] {
+                    a.raw_set("__songlua_draw_state_mode", mode).unwrap();
+                    a.raw_set("__songlua_line_width", width).unwrap();
+                    let range = lua.create_table().unwrap();
+                    range.raw_set("First", first).unwrap();
+                    range.raw_set("Num", num).unwrap();
+                    a.raw_set("__songlua_draw_state", range).unwrap();
+                    let expected = bits(before::read_actor_multi_vertex_mesh(&a));
+                    let first = published(&a, &mut cache).unwrap();
+                    let second = published(&a, &mut cache).unwrap();
+                    assert_eq!(bits(Ok(first.clone())), expected);
+                    assert_eq!(bits(Ok(second.clone())), expected);
+                    if let (Some(first), Some(second)) = (first, second) {
+                        assert!(Arc::ptr_eq(&first, &second));
+                    }
+                }
+            }
+        }
+    }
+}
