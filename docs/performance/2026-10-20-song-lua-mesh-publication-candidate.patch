+#[test]
+fn native_mesh_publication_releases_previous_mesh_before_lua_collection() {
+    let lua = Lua::new();
+    let a = actor(&lua, 8, Some("DrawMode_Quads"), false);
+    install_actor_display_state_methods(&lua, &a).unwrap();
+    let vertices = actor(&lua, 8, None, true).get::<Table>("__songlua_vertices").unwrap();
+    let upload = a.get::<Function>("SetVertices").unwrap();
+    let mut cache = ActorMultiVertexMeshCache::default();
+    upload.call::<()>((a.clone(), vertices.clone())).unwrap();
+    // Root the old userdata explicitly so collection cannot hide retention.
+    let old_upload = a.raw_get::<mlua::AnyUserData>("__songlua_vertices").unwrap();
+    let snapshot = published(&a, &mut cache).unwrap().unwrap();
+    assert_eq!(Arc::strong_count(&snapshot), 2);
+    upload.call::<()>((a.clone(), vertices)).unwrap();
+    let current = published(&a, &mut cache).unwrap().unwrap();
+    assert_eq!(Arc::strong_count(&snapshot), 1, "only the old draw retains the old mesh");
+    assert_eq!(old_upload.borrow::<Arc<[SongLuaActorMultiVertexPoint]>>().unwrap().len(), 8);
+    assert_eq!(current.len(), 12);
+    a.raw_set("__songlua_vertices", Value::Nil).unwrap();
+    assert!(published(&a, &mut cache).unwrap().is_none());
+    assert_eq!(Arc::strong_count(&current), 1, "cleared geometry releases the publication");
+}
