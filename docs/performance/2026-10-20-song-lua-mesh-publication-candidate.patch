+// Publication owns at most one derived mesh per visual slot. Lua uploads keep
+// their existing immutable point buffers; replacing a publication releases its
+// old mesh independently of when Lua collects the old upload userdata.
+#[derive(Default)]
+pub(crate) struct ActorMultiVertexMeshCache {
+    entry: Option<(Arc<[SongLuaActorMultiVertexPoint]>, MultiVertexMeshKey,
+                   Option<Arc<[SongLuaOverlayMeshVertex]>>)>,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+struct MultiVertexMeshKey {
+    start: usize,
+    end: usize,
+    mode: MultiVertexMeshMode,
+    width_bits: u32,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum MultiVertexMeshMode { Triangles, Quads, QuadStrip, LineStrip, Fan }
+
+impl MultiVertexMeshMode {
+    fn from_str(mode: &str) -> Self {
+        if mode.eq_ignore_ascii_case("DrawMode_Quads") { Self::Quads }
+        else if mode.eq_ignore_ascii_case("DrawMode_QuadStrip") { Self::QuadStrip }
+        else if mode.eq_ignore_ascii_case("DrawMode_LineStrip") { Self::LineStrip }
+        else if mode.eq_ignore_ascii_case("DrawMode_Fan") { Self::Fan }
+        else { Self::Triangles }
+    }
+}
