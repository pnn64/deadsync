+    pub fn with_capacity(array: usize, records: usize) -> Result<Self, Error> {
+        let failed = || Error::new(ErrorKind::Runtime, 0, "not enough memory");
+        let slots = if records == 0 {
+            0
+        } else {
+            records
+                .checked_mul(4)
