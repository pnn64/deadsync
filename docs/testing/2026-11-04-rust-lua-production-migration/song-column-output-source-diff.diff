+struct Fixture {
+    _dir: tempfile::TempDir,
+    native: mlua::Lua,
+    rust: RustSongRuntime,
+    native_capture: test_support::LegacyColumnSplineCapture,
+    rust_capture: SongColumnSplineCapture,
+}
+impl Fixture {
+    fn new() -> Self {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("default.lua");
+        std::fs::write(&path, "return Def.ActorFrame{}").unwrap();
+        let context = SongLuaCompileContext::new(dir.path(), "column compiler output");
+        let native = test_support::legacy_song_compilation_vm();
+        test_support::legacy_activate_song_layers(&native, &[&path], 0, &context).unwrap();
+        let mut rust = RustSongRuntime::new(&context).unwrap();
+        rust.begin_song_compilation().unwrap();
+        let (scene, selected) = rust.construct_gameplay_screen(&context).unwrap();
+        rust.load_gameplay_theme(scene, &selected).unwrap();
+        let plan = SongLayerPlan::new(&[&path], 0, &context).unwrap();
+        rust.initialize_song_layers(scene, &plan).unwrap().unwrap();
+        rust.activate_song_layers(scene, &context).unwrap().unwrap();
+        let mut this = Self {
+            _dir: dir,
+            native,
+            rust,
+            native_capture: Default::default(),
+            rust_capture: Default::default(),
+        };
+        this.script(r#"
+            events={}
+            function mark(key)events[#events+1]=key end
+            function handler(points,mode)
+                return {__songlua_spline_mode=mode or 'NoteColumnSplineMode_Position',
+                    __songlua_beats_per_t=1,__songlua_receptor_t=0,__songlua_subtract_song_beat=true,
+                    __songlua_spline={__songlua_spline_size=#points,__songlua_spline_points=points,__songlua_spline_loop=false}}
+            end
+            function column(player,index,pos,zoom)
+                return {__songlua_player_index=player,__songlua_column_index=index,
+                    __songlua_pos_handler=pos,__songlua_zoom_handler=zoom}
+            end
+            function install(first,second)
+                __songlua_top_screen_player_1=first and {__songlua_children={NoteField={__songlua_note_columns=first}}}
+                __songlua_top_screen_player_2=second and {__songlua_children={NoteField={__songlua_note_columns=second}}}
+            end
+        "#);
+        this
+    }
+    fn script(&mut self, source: &str) {
+        self.native.load(source).exec().unwrap();
+        self.rust
+            .vm_mut()
+            .execute(&compile_named(source.as_bytes(), b"=column output fixture").unwrap())
+            .unwrap();
+        self.events();
+    }
+    fn events(&mut self) -> String {
+        let native: String = self
+            .native
+            .load("return table.concat(events,'|')")
+            .eval()
+            .unwrap();
+        let Value::String(id) = self
+            .rust
+            .vm_mut()
+            .execute(&compile_named(b"return table.concat(events,'|')", b"=column events").unwrap())
+            .unwrap()[0]
+        else {
+            panic!()
+        };
+        assert_eq!(
+            self.rust.vm_mut().string_bytes(id).unwrap(),
+            native.as_bytes()
+        );
+        native
+    }
+    fn sample(&mut self, second: f32, error: Option<&str>) {
+        let a = self.native_capture.capture(&self.native, second);
+        let b = self
+            .rust
+            .capture_song_column_splines(&mut self.rust_capture, second);
+        assert_eq!(a.is_err(), b.is_err(), "native={a:?} Rust={b:?}");
+        assert_eq!(a.is_err(), error.is_some(), "native={a:?} Rust={b:?}");
+        if let Some(message) = error.filter(|s| !s.is_empty()) {
+            assert!(a.unwrap_err().contains(message));
+            assert!(b.unwrap_err().contains(message));
+        }
+        self.events();
+    }
+    fn hides(&mut self, error: bool) -> Vec<deadsync_song_lua::SongLuaNoteHideWindow> {
+        let a = test_support::legacy_note_column_zoom_hides(&self.native);
+        let b = self.rust.read_song_note_column_zoom_hides();
+        assert_eq!(a.is_err(), b.is_err(), "native={a:?} Rust={b:?}");
+        assert_eq!(a.is_err(), error, "native={a:?} Rust={b:?}");
+        self.events();
+        match (a, b) {
+            (Ok(a), Ok(b)) => {
+                assert_eq!(a, b);
+                b
+            }
+            _ => Vec::new(),
+        }
+    }
+    fn finish(&mut self) -> Vec<Track> {
+        let a = std::mem::take(&mut self.native_capture).finish();
+        let b = std::mem::take(&mut self.rust_capture).finish().unwrap();
+        assert_tracks(&a, &b);
+        b
+    }
+}
+fn assert_tracks(a: &[Track], b: &[Track]) {
+    assert_eq!(a.len(), b.len());
+    let mut checked = HashSet::new();
+    let mut left = Vec::new();
+    let mut right = Vec::new();
+    for (a, b) in a.iter().zip(b) {
+        assert_eq!(
+            (a.player, a.column, a.time_offset.to_bits()),
+            (b.player, b.column, b.time_offset.to_bits())
+        );
+        assert_eq!(a.frames.len(), b.frames.len());
+        for (a, b) in a.frames.iter().zip(b.frames.iter()) {
+            assert_eq!(a.second.to_bits(), b.second.to_bits());
+            for (a, b) in [(&a.position, &b.position), (&a.zoom, &b.zoom)] {
+                assert_eq!(a.is_some(), b.is_some());
+                if let (Some(a), Some(b)) = (a, b) {
+                    assert_spline(a, b, &mut checked);
+                    left.push(a);
+                    right.push(b);
+                }
+            }
+        }
+    }
+    for i in 0..left.len() {
+        for j in 0..left.len() {
+            assert_eq!(
+                Arc::ptr_eq(&left[i].coefficients, &left[j].coefficients),
+                Arc::ptr_eq(&right[i].coefficients, &right[j].coefficients),
+                "coefficient sharing {i}/{j}"
+            );
+        }
+    }
+}
+fn assert_spline(a: &Spline, b: &Spline, checked: &mut HashSet<(usize, usize)>) {
+    assert_eq!(
+        (
+            a.constant,
+            a.looping,
+            a.subtract_song_beat,
+            a.beats_per_t.to_bits(),
+            a.receptor_t.to_bits()
+        ),
+        (
+            b.constant,
+            b.looping,
+            b.subtract_song_beat,
+            b.beats_per_t.to_bits(),
+            b.receptor_t.to_bits()
+        )
+    );
+    assert_eq!(a.coefficients.len(), b.coefficients.len());
+    if !checked.insert((
+        a.coefficients.as_ptr() as usize,
+        b.coefficients.as_ptr() as usize,
+    )) {
+        return;
+    }
+    for (index, (a, b)) in a.coefficients.iter().zip(b.coefficients.iter()).enumerate() {
+        for axis in 0..3 {
+            for term in 0..4 {
+                assert_eq!(
+                    a[axis][term].to_bits(),
+                    b[axis][term].to_bits(),
+                    "coefficient {index}/{axis}/{term}"
+                );
+            }
+        }
+    }
+}
