+use deadlib_lua::{Value, compile_named};
+use deadsync_gameplay::{SongLuaColumnSplineTrack as Track, SongLuaSplineData as Spline};
+use deadsync_song_lua::{
+    SongLuaCompileContext,
+    rust_engine::{RustSongRuntime, SongColumnSplineCapture, SongLayerPlan, test_support},
+};
+use std::{collections::HashSet, sync::Arc};
