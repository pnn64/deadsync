+fn tracked_target_key(target: deadsync_song_lua::SongLuaTrackedActorTarget) -> (u8, usize) {
+    use deadsync_song_lua::SongLuaTrackedActorTarget as T;
+    match target {
+        T::Player(i) => (0, i),
+        T::PlayerJudgment(i) => (1, i),
+        T::PlayerCombo(i) => (2, i),
+        T::SongForeground => (3, 0),
+        T::ScreenLayer(i) => (4, i),
+    }
+}
+fn compare_tracked_output(pair: &mut Pair) -> deadsync_song_lua::rust_engine::SongTrackedActors {
+    let expected = test_support::legacy_read_song_tracked_actors(&pair.native).unwrap();
+    let actual = pair
+        .rust
+        .read_song_tracked_actors(pair.scene)
+        .unwrap()
+        .unwrap();
+    assert_eq!(actual.actors.len(), expected.len());
+    for (a, b) in actual.actors.iter().zip(&expected) {
+        assert_eq!(tracked_target_key(a.target), tracked_target_key(b.target));
+        assert_eq!(
+            a.actor,
+            b.actor,
+            "tracked target {:?}",
+            tracked_target_key(a.target)
+        );
+        assert!(matches!(
+            pair.rust.song_tracked_actor_value(a).unwrap(),
+            Value::Table(_)
+        ));
+    }
+    pair.compare();
+    actual
+}
