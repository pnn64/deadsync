+// Reuse Player::Init's actual HUD constructors for compiler fallback children.
+pub(super) fn tracked_child(
+    call: &mut HostCall<'_>,
+    store: &Shared,
+    scene: u64,
+    player: TableId,
+    index: usize,
+    name: &str,
+) -> Result<TableId, Error> {
+    let child = match name {
+        "Judgment" => judgment(call, store, scene, player, index)?,
+        "Combo" => combo(call, store, scene, index)?,
+        _ => unreachable!(),
+    };
+    underlay::copy_tags(call, player, child)?;
+    let value = call.try_intern(name.as_bytes())?;
+    set(call, child, "__songlua_player_child_name", value)?;
+    native_children::adopt(call, store, child, player)?;
+    native_children::insert(call, player, name, Value::Table(child))?;
+    append(call, store, player, child)?;
+    lifecycle::invalidate_plans(call, store)?;
+    Ok(child)
+}
