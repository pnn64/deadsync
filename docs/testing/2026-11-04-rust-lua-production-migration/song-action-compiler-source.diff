+fn compare_compiled_actions(
+    pair: &mut Pair,
+    keys: &[&str],
+    tracked: &[&str],
+    reader: bool,
+    mut state: ActionPublished,
+) -> (ActionPublished, Result<Option<bool>, (String, String)>) {
+    let (mut native, mut rust) = (Vec::new(), Vec::new());
+    for key in keys.iter().chain(tracked) {
+        let (a, b) = saved_pair(pair, key);
+        native.push(a);
+        rust.push(Value::Table(b));
+    }
+    if state.overlays.is_empty() {
+        for (n, r) in native.iter().zip(&rust).take(keys.len()) {
+            let a = test_support::legacy_capture_actor_messages(&pair.native, n).unwrap();
+            let b = pair.rust.capture_song_actor_message_commands(*r).unwrap();
+            assert_eq!(a.commands, b.commands);
+            state.overlays.push(b.commands);
+        }
+    }
+    if state.tracked.is_empty() {
+        for (n, r) in native.iter().zip(&rust).skip(keys.len()) {
+            let a = test_support::legacy_capture_actor_messages(&pair.native, n).unwrap();
+            let b = pair.rust.capture_song_actor_message_commands(*r).unwrap();
+            assert_eq!(a.commands, b.commands);
+            state.tracked.push(b.commands);
+        }
+    }
+    let mut expected = state.clone();
+    let mut actual = state;
+    let mut en = std::mem::take(&mut expected.overlays);
+    en.extend(std::mem::take(&mut expected.tracked));
+    let mut ar = std::mem::take(&mut actual.overlays);
+    ar.extend(std::mem::take(&mut actual.tracked));
+    let mut nt = native
+        .into_iter()
+        .zip(en.iter_mut())
+        .map(|(actor, commands)| test_support::LegacyMessageTarget { actor, commands })
+        .collect::<Vec<_>>();
+    let mut rt = rust
+        .into_iter()
+        .zip(ar.iter_mut())
+        .map(
+            |(actor, commands)| deadsync_song_lua::rust_engine::SongMessageTarget {
+                actor,
+                commands,
+            },
+        )
+        .collect::<Vec<_>>();
+    let (a, b) = nt.split_at_mut(keys.len());
+    let er = if reader {
+        let table: Option<mlua::Table> = pair.native.globals().get("actions_probe").unwrap();
+        test_support::legacy_read_overlay_actions(&pair.native, table, a, b, &mut expected.output())
+            .map(|()| None)
+    } else {
+        let function: mlua::Function = pair.native.globals().get("compile_probe").unwrap();
+        test_support::legacy_compile_function_action(
+            &pair.native,
+            a,
+            b,
+            &function,
+            4.,
+            true,
+            &mut expected.output(),
+        )
+        .map(Some)
+    };
+    let (a, b) = rt.split_at_mut(keys.len());
+    let rr = if reader {
+        let table = pair.rust.vm_mut().get_global(b"actions_probe").unwrap();
+        pair.rust
+            .read_song_overlay_actions(Some(table), a, b, &mut actual.output())
+            .map(|()| None)
+    } else {
+        let function = pair.rust.vm_mut().get_global(b"compile_probe").unwrap();
+        pair.rust
+            .compile_song_function_action(a, b, function, 4., true, &mut actual.output())
+            .map(Some)
+    };
+    expected.tracked = en.split_off(keys.len());
+    expected.overlays = en;
+    actual.tracked = ar.split_off(keys.len());
+    actual.overlays = ar;
+    assert_eq!(er.is_err(), rr.is_err(), "native={er:?}, Rust={rr:?}");
+    assert_eq!(format!("{expected:?}"), format!("{actual:?}"));
+    assert_eq!(
+        pair.rust.values().unwrap(),
+        deadsync_song_lua::compile_song_runtime_values(&pair.native).unwrap()
+    );
+    pair.compare();
+    let result = match (er, rr) {
+        (Ok(a), Ok(b)) => {
+            assert_eq!(a, b);
+            Ok(b)
+        }
+        (Err(a), Err(b)) => Err((a, b)),
+        _ => unreachable!(),
+    };
+    (actual, result)
+}
