+pub fn legacy_compile_function_action(
+    lua: &mlua::Lua,
+    targets: &mut [LegacyMessageTarget<'_>],
+    tracked: &mut [LegacyMessageTarget<'_>],
+    function: &mlua::Function,
+    beat: f32,
+    persists: bool,
+    output: &mut super::SongActionOutput<'_>,
+) -> Result<bool, String> {
+    let mut overlays = legacy_message_overlays(targets);
+    let mut tracked_actors = legacy_action_tracked(tracked);
+    let result = crate::lua_util::compile_overlay_compile_actor_function_action(
+        lua,
+        &mut overlays,
+        &mut tracked_actors,
+        function,
+        beat,
+        persists,
+        output.counter,
+        output.messages,
+        output.sound_events,
+    );
+    for (target, row) in targets.iter_mut().zip(overlays) {
+        *target.commands = row.actor.message_commands;
+    }
+    for (target, row) in tracked.iter_mut().zip(tracked_actors) {
+        *target.commands = row.actor.message_commands;
+    }
+    result
+}
+pub fn legacy_read_overlay_actions(
+    lua: &mlua::Lua,
+    table: Option<mlua::Table>,
+    targets: &mut [LegacyMessageTarget<'_>],
