+fn compare_overlay_ease(
+    pair: &mut Pair,
+    overlays: &[(usize, &str)],
+    probes: &[&str],
+    params: deadsync_song_lua::SongLuaOverlayEaseBuildParams,
+) -> Result<Vec<deadsync_song_lua::SongLuaOverlayEase>, (String, String)> {
+    let (mut a, mut b, mut x, mut y) = (Vec::new(), Vec::new(), Vec::new(), Vec::new());
+    for &(i, key) in overlays {
+        let (n, r) = saved_pair(pair, key);
+        a.push((i, n));
+        b.push((i, Value::Table(r)));
+    }
+    for key in probes {
+        let (n, r) = saved_pair(pair, key);
+        x.push(n);
+        y.push(Value::Table(r));
+    }
+    let f: mlua::Function = pair.native.globals().get("ease_probe").unwrap();
+    let g = pair.rust.vm_mut().get_global(b"ease_probe").unwrap();
+    let expected = test_support::legacy_capture_overlay_function_eases(
+        &pair.native,
+        &a,
+        &f,
+        params.clone(),
+        [2., 6.],
+        &x,
+    );
+    let actual = pair
+        .rust
+        .capture_song_overlay_function_eases(&b, g, params, [2., 6.], &y);
+    assert_eq!(
+        actual.is_err(),
+        expected.is_err(),
+        "native={expected:?}, Rust={actual:?}"
+    );
+    assert_eq!(
+        pair.rust.values().unwrap(),
+        deadsync_song_lua::compile_song_runtime_values(&pair.native).unwrap()
+    );
+    pair.compare();
+    match (expected, actual) {
+        (Ok(a), Ok(b)) => {
+            assert_eq!(a, b);
+            Ok(b)
+        }
+        (Err(a), Err(b)) => Err((a, b)),
+        _ => unreachable!(),
+    }
+}
