+fn standalone_overlay_pair(source: &str) -> (tempfile::TempDir, Pair) {
+    let dir = tempfile::tempdir().unwrap();
+    let context = SongLuaCompileContext::new(dir.path(), "overlay compiler tree");
+    let native = test_support::legacy_preparation_actor_scene(source, &context).unwrap();
+    let mut rust = RustSongRuntime::new(&context).unwrap();
+    rust.begin_song_compilation().unwrap();
+    rust.begin_actor_preparation().unwrap();
+    let declaration = rust
+        .vm_mut()
+        .execute(&compile_named(source.as_bytes(), b"=overlay tree").unwrap())
+        .unwrap()[0];
+    let scene = rust.instantiate_actor(declaration).unwrap();
+    let root = rust.actor_scene_root(scene).unwrap();
+    rust.vm_mut().set_global(b"root", root).unwrap();
+    let mut pair = Pair {
+        native,
+        rust,
+        scene,
+        context,
+    };
+    pair.script("prepared_root=nil;__songlua_top_screen=nil;events={};saved={root=root};function log(...)local t={};for i=1,select('#',...)do t[i]=tostring(select(i,...))end;events[#events+1]=table.concat(t,',')end");
+    (dir, pair)
+}
+fn compare_overlay_tree(
+    pair: &mut Pair,
+    hide_root: bool,
+) -> Result<deadsync_song_lua::rust_engine::SongOverlayActors<OutputKind>, (String, String)> {
+    let (a, b) = saved_pair(pair, "root");
+    if hide_root {
+        pair.script("saved.root=nil;root=nil");
+    }
+    let context = pair.context.clone();
+    let (mut ns, mut rs) = (Vec::new(), Vec::new());
+    let expected = test_support::legacy_read_song_overlay_tree(
+        &pair.native,
+        a,
+        &context,
+        |_, _, _| Ok(std::sync::Arc::from([7u32, 0u32])),
+        output_kind_layer,
+        |d| ns.push(d),
+    );
+    let actual = pair.rust.read_song_overlay_actors(
+        Value::Table(b),
+        &context,
+        |_, _, _| Ok(std::sync::Arc::from([7u32, 0u32])),
+        output_kind_layer,
+        |d| rs.push(d),
+    );
+    assert_eq!(
+        actual.is_err(),
+        expected.is_err(),
+        "native={:?}, Rust={:?}",
+        expected.as_ref().err(),
+        actual.as_ref().err()
+    );
+    assert_eq!(ns.len(), rs.len());
+    pair.compare();
+    match (expected, actual) {
+        (Ok(a), Ok(b)) => {
+            assert_eq!(
+                a.len(),
+                b.actors.len(),
+                "native={:?}, Rust={:?}",
+                a.iter().map(|r| &r.actor).collect::<Vec<_>>(),
+                b.actors.iter().map(|r| &r.actor).collect::<Vec<_>>()
+            );
+            for (a, b) in a.iter().zip(&b.actors) {
+                assert_eq!(format!("{:?}", a.actor), format!("{:?}", b.actor));
+                assert_eq!(a.message_sounds, b.message_sounds);
+            }
+            Ok(b)
+        }
+        (Err(a), Err(b)) => Err((a, b)),
+        _ => unreachable!(),
+    }
+}
