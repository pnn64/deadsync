+fn compare_function_ease_probe(
+    pair: &mut Pair,
+) -> Result<
+    (
+        Option<deadsync_song_lua::SongLuaEaseTarget>,
+        Vec<String>,
+        Vec<usize>,
+    ),
+    String,
+> {
+    let known: Vec<mlua::Table> = pair.native.globals().get("probe_ids").unwrap();
+    let Value::Table(ids) = pair.rust.vm_mut().get_global(b"probe_ids").unwrap() else {
+        panic!()
+    };
+    let ids = (1..=known.len())
+        .map(|i| {
+            pair.rust
+                .vm_mut()
+                .raw_table_get(ids, Value::Number(i as f64))
+                .unwrap()
+        })
+        .collect::<Vec<_>>();
+    let f = pair
+        .native
+        .globals()
+        .get::<mlua::Function>("probe_fn")
+        .unwrap();
+    let native = deadsync_song_lua::probe_function_ease_target(&pair.native, &f).map(
+        |(target, methods, actors)| {
+            (
+                target,
+                methods,
+                actors
+                    .into_iter()
+                    .map(|id| {
+                        known
+                            .iter()
+                            .position(|t| t.to_pointer() as usize == id)
+                            .unwrap_or(usize::MAX)
+                    })
+                    .collect::<Vec<_>>(),
+            )
+        },
+    );
+    let f = pair.rust.vm_mut().get_global(b"probe_fn").unwrap();
+    let rust = pair.rust.probe_song_function_ease_target(f);
+    assert_eq!(
+        rust.is_ok(),
+        native.is_ok(),
+        "native={:?} rust={:?}",
+        native.as_ref().err(),
+        rust.as_ref().err()
+    );
+    let rust = rust.map(|mut r| {
+        let actors = pair
+            .rust
+            .song_function_ease_probe_actors(&r)
+            .unwrap()
+            .into_iter()
+            .map(|v| ids.iter().position(|id| *id == v).unwrap_or(usize::MAX))
+            .collect::<Vec<_>>();
+        let out = (r.target.clone(), r.methods.clone(), actors);
+        pair.rust.release_song_function_ease_probe(&mut r).unwrap();
+        out
+    });
+    if let (Ok(a), Ok(b)) = (&rust, &native) {
+        assert_eq!(a, b);
+    }
+    assert_eq!(
+        pair.rust.values().unwrap(),
+        deadsync_song_lua::compile_song_runtime_values(&pair.native).unwrap()
+    );
+    pair.compare();
+    rust
+}
+fn compare_function_eases(
+    pair: &mut Pair,
+    keys: &[&str],
+) -> Result<deadsync_song_lua::SongLuaReadEasesResult, String> {
+    let mut actors = Vec::new();
+    let mut values = Vec::new();
+    for key in keys {
+        let (a, b) = saved_pair(pair, key);
+        actors.push(a);
+        values.push((values.len(), Value::Table(b)));
+    }
+    let mut names = easing_reader_names(pair);
+    let native = test_support::legacy_read_function_eases(
+        &pair.native,
+        pair.native.globals().get("eases_probe").unwrap(),
+        deadsync_song_lua::SongLuaTimeUnit::Beat,
+        &names.0,
+        &actors,
+    );
+    let table = pair.rust.vm_mut().get_global(b"eases_probe").unwrap();
+    let rust = pair.rust.read_song_eases_for_overlay_actors(
+        Some(table),
+        deadsync_song_lua::SongLuaTimeUnit::Beat,
+        &names.1,
+        &values,
+    );
+    pair.rust.release_song_easing_names(&mut names.1).unwrap();
+    assert_eq!(
+        rust.is_ok(),
+        native.is_ok(),
+        "native={:?} rust={:?}",
+        native.as_ref().err(),
+        rust.as_ref().err()
+    );
+    if let (Ok(a), Ok(b)) = (&rust, &native) {
+        assert_eq!(
+            (&a.eases, &a.overlay_eases, &a.column_offsets, &a.info),
+            (&b.0, &b.1, &b.2, &b.3)
+        );
+        assert!(a.stats.probe_ms >= 0. && a.stats.overlay_capture_ms >= 0.);
+    }
+    assert_eq!(
+        pair.rust.values().unwrap(),
+        deadsync_song_lua::compile_song_runtime_values(&pair.native).unwrap()
+    );
+    pair.compare();
+    rust
+}
