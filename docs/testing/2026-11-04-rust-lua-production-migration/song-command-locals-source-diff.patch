+fn command_scope_pair(source: &str) -> (tempfile::TempDir, Pair) {
+    let dir = tempfile::tempdir().unwrap();
+    let path = write(dir.path(), "default.lua", source);
+    let mut pair = Pair::new(SongLuaCompileContext::new(
+        dir.path(),
+        "nested command locals",
