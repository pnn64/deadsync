+fn compare_column_samples(
+    pair: &mut Pair,
+    globals: bool,
+) -> Result<Vec<deadsync_song_lua::SongLuaColumnTransformSample>, String> {
+    let native = if globals {
+        deadsync_song_lua::read_note_column_transform_samples(&pair.native)
+    } else {
+        deadsync_song_lua::read_note_column_transform_samples_for_fields(
+            pair.native
+                .globals()
+                .get::<Vec<mlua::Table>>("fields_probe")
+                .unwrap(),
+        )
+    };
+    let rust = if globals {
+        pair.rust.read_song_note_column_transform_samples()
+    } else {
+        let Value::Table(list) = pair.rust.vm_mut().get_global(b"fields_probe").unwrap() else {
+            panic!()
+        };
+        let mut fields = Vec::new();
+        for i in 1usize.. {
+            let v = pair
+                .rust
+                .vm_mut()
+                .raw_table_get(list, Value::Number(i as f64))
+                .unwrap();
+            if v == Value::Nil {
+                break;
+            }
+            fields.push(v);
+        }
+        pair.rust
+            .read_song_note_column_transform_samples_for_fields(&fields)
+    };
+    assert_eq!(
+        rust.is_ok(),
+        native.is_ok(),
+        "native={native:?} rust={rust:?}"
+    );
+    if let (Ok(a), Ok(b)) = (&rust, &native) {
+        assert_eq!(a, b);
+    }
