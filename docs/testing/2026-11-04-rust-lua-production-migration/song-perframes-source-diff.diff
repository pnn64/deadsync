+/// Execute the production sampled-perframe pass against supplied compiler rows.
+pub fn legacy_compile_perframes(
+    lua: &mlua::Lua,
+    tables: [Option<mlua::Table>; 2],
+    context: &crate::SongLuaCompileContext,
+    targets: &mut [LegacyMessageTarget<'_>],
+    messages: &[crate::SongLuaMessageEvent],
+) -> Result<
+    (
+        Vec<crate::SongLuaEaseWindow>,
+        Vec<crate::SongLuaOverlayEase>,
+        crate::SongLuaCompileInfo,
+    ),
+    String,
+> {
+    let mut overlays = legacy_message_overlays(targets);
+    let tracked = legacy_read_song_tracked_actors(lua)?;
+    let [prefix, global] = tables;
+    crate::compile_perframes(
