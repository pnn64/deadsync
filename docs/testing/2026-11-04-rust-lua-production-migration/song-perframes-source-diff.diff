+            .vm
+            .call(function, &[number(beat), number(delta_seconds)])
+            .map(|_| ())
+            .map_err(|e| e.to_string());
+        self.set_values(previous.0, previous.1)
+            .map_err(|e| e.to_string())?;
+        self.set_delta_values(previous_delta.0, previous_delta.1)
+            .map_err(|e| e.to_string())?;
