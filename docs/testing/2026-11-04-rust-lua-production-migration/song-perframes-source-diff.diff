+        }
+        crate::push_perframe_player_targets(
+            &mut output.0,
+            self.beat,
+            end,
+            &self.players,
+            &next.players,
+            baseline_players,
+        );
+        crate::push_perframe_overlay_targets(
+            &mut output.1,
+            self.beat,
+            end,
+            &self.overlays,
+            &next.overlays,
+            baseline_overlays,
+            false,
+        );
+    }
+}
