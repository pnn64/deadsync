+fn compare_sampled_perframes(
+    source: &str,
+    commands: Vec<Vec<deadsync_song_lua::SongLuaOverlayMessageCommand>>,
+    messages: Vec<deadsync_song_lua::SongLuaMessageEvent>,
+    expect_error: bool,
+) -> (tempfile::TempDir, Pair, Option<PerframeOutput>) {
+    use deadsync_song_lua::rust_engine::SongMessageTarget;
+    let dir = tempfile::tempdir().unwrap();
+    let path = write(dir.path(), "default.lua", source);
+    let mut context = SongLuaCompileContext::new(dir.path(), "sampled perframes");
+    context.song_music_rate = 1.5;
+    let mut pair = Pair::new(context.clone());
+    drop(pair.activate(&[&path]));
+    pair.rust.end_actor_capture();
+    let mut native_values = Vec::new();
+    let mut rust_values = Vec::new();
+    for key in ["actor", "quad"] {
+        let (native, rust) = saved_pair(&mut pair, key);
+        native_values.push(native);
+        rust_values.push(Value::Table(rust));
+    }
+    let mut tracked = pair
+        .rust
+        .read_song_tracked_actors(pair.scene)
+        .unwrap()
+        .unwrap();
+    let native_tables: (Option<mlua::Table>, Option<mlua::Table>) = pair
+        .native
+        .load("return prefix_globals and prefix_globals.perframes, mod_perframes")
+        .eval()
+        .unwrap();
+    let rust_tables = pair
+        .rust
+        .vm_mut()
+        .execute(
+            &compile_named(
+                b"return prefix_globals and prefix_globals.perframes, mod_perframes",
+                b"=perframe selection",
+            )
+            .unwrap(),
+        )
+        .unwrap()
+        .to_vec();
+    let mut native_commands = commands.clone();
+    let mut rust_commands = commands;
+    let native = {
+        let mut targets = native_values
+            .iter()
+            .zip(&mut native_commands)
+            .map(|(actor, commands)| test_support::LegacyMessageTarget {
+                actor: actor.clone(),
+                commands,
+            })
+            .collect::<Vec<_>>();
+        test_support::legacy_compile_perframes(
+            &pair.native,
+            [native_tables.0, native_tables.1],
+            &context,
+            &mut targets,
+            &messages,
+        )
+    };
+    let rust = {
+        let targets = rust_values
+            .iter()
+            .zip(&mut rust_commands)
+            .map(|(&actor, commands)| SongMessageTarget { actor, commands })
+            .collect::<Vec<_>>();
+        test_support::compile_perframes_for_tables(
+            &mut pair.rust,
+            [0, 1].map(|i| (rust_tables[i] != Value::Nil).then_some(rust_tables[i])),
+            &context,
+            &targets,
+            &tracked,
+            &messages,
+        )
+    };
+    assert_eq!(
+        rust.is_err(),
+        native.is_err(),
+        "native={:?} Rust={:?}",
+        native.as_ref().err(),
+        rust.as_ref().err()
+    );
+    assert_eq!(rust.is_err(), expect_error);
+    let output = match (rust, native) {
+        (Ok(rust), Ok(native)) => {
+            assert_eq!(format!("{rust:?}"), format!("{native:?}"));
+            Some(rust)
+        }
+        (Err(rust), Err(native)) => {
+            assert!(rust.contains("perframe failure"), "{rust}");
+            assert!(native.contains("perframe failure"), "{native}");
+            None
+        }
+        _ => unreachable!(),
+    };
+    pair.compare();
+    pair.rust.release_song_tracked_actors(&mut tracked).unwrap();
+    (dir, pair, output)
