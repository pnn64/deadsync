+    active.as_mut().unwrap().elapsed = Some(elapsed);
+    if let Some(epoch) = crate::motion_restart_epoch(
+        message.base,
+        &command.blocks,
+        elapsed,
+        crate::song_elapsed_seconds_at(message.start, context),
+    ) {
+        access.motion(
+            row.actor,
+            epoch,
+            crate::song_elapsed_seconds_at(beat, context),
