+fn easing_reader_names(
+    pair: &mut Pair,
+) -> (
+    deadsync_song_lua::SongLuaHostState,
+    deadsync_song_lua::rust_engine::SongEasingNames,
+) {
+    let mut native = deadsync_song_lua::SongLuaHostState::default();
+    deadsync_song_lua::register_loaded_easing_names(&pair.native, &mut native).unwrap();
+    let mut rust = pair.rust.new_song_easing_names().unwrap();
+    pair.rust
+        .register_loaded_song_easing_names(&mut rust)
+        .unwrap();
+    (native, rust)
+}
+
+fn easing_result_text(out: &deadsync_song_lua::SongLuaReadEasesResult) -> String {
+    format!(
+        "{:?}",
+        (
+            &out.eases,
+            &out.overlay_eases,
+            &out.column_offsets,
+            &out.info,
+            out.stats
+        )
+    )
+}
+macro_rules! ease_reader_metadata {
+    ($i:ident) => {
+        format!(
+            "{:?}",
+            (
+                $i.unit,
+                $i.start,
+                $i.limit,
+                $i.span_mode,
+                $i.from,
+                $i.to,
+                &$i.easing,
+                $i.sustain,
+                $i.opt1,
+                $i.opt2
+            )
+        )
+    };
+}
+fn compare_easing_reader(
+    pair: &mut Pair,
+    names: &(
+        deadsync_song_lua::SongLuaHostState,
+        deadsync_song_lua::rust_engine::SongEasingNames,
+    ),
+    unit: deadsync_song_lua::SongLuaTimeUnit,
+    choose: impl Fn(f32) -> deadsync_song_lua::SongLuaFunctionEaseDecision,
+) -> Result<deadsync_song_lua::SongLuaReadEasesResult, String> {
+    let mut native_inputs = Vec::new();
+    let expected = deadsync_song_lua::read_eases_with_function_capture(
+        pair.native.globals().get("eases_probe").unwrap(),
+        unit,
+        &names.0.easing_names,
+        |input, info| {
+            native_inputs.push(ease_reader_metadata!(input));
+            input
+                .function
+                .call::<mlua::Value>(input.from)
+                .map_err(|e| e.to_string())?;
+            info.unsupported_function_eases += 1;
+            Ok(deadsync_song_lua::SongLuaFunctionEaseResult {
+                decision: choose(input.start),
+                stats: deadsync_song_lua::SongLuaReadEasesStats {
+                    entry_count: 100,
+                    function_targets: 200,
+                    overlay_capture_attempts: 3,
+                    overlay_capture_outputs: 4,
+                    probe_ms: 0.25,
+                    overlay_capture_ms: 0.5,
+                },
+            })
+        },
+    );
+    let mut rust_inputs = Vec::new();
+    let table = pair.rust.vm_mut().get_global(b"eases_probe").unwrap();
+    let actual = pair.rust.read_song_eases_with_function_capture(
+        Some(table),
+        unit,
+        &names.1,
+        |runtime, input, info| {
+            rust_inputs.push(ease_reader_metadata!(input));
+            runtime
+                .vm_mut()
+                .call(input.function, &[Value::Number(f64::from(input.from))])
+                .map_err(|e| e.to_string())?;
+            info.unsupported_function_eases += 1;
+            Ok(deadsync_song_lua::SongLuaFunctionEaseResult {
+                decision: choose(input.start),
+                stats: deadsync_song_lua::SongLuaReadEasesStats {
+                    entry_count: 100,
+                    function_targets: 200,
+                    overlay_capture_attempts: 3,
+                    overlay_capture_outputs: 4,
+                    probe_ms: 0.25,
+                    overlay_capture_ms: 0.5,
+                },
+            })
+        },
+    );
+    assert_eq!(rust_inputs, native_inputs);
+    assert_eq!(
+        actual.is_ok(),
+        expected.is_ok(),
+        "native={:?} rust={:?}",
+        expected.as_ref().err(),
+        actual.as_ref().err()
+    );
+    if let (Ok(a), Ok(b)) = (&actual, &expected) {
+        assert_eq!(easing_result_text(a), easing_result_text(b));
+    }
+    pair.compare();
+    actual
+}
