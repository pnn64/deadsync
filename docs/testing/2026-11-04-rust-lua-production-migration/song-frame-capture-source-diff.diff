+        );
+        let b = self.rust.capture_song_overlay_frame(
+            self.scene,
+            &mut self.b,
+            &self.actors,
+            &self.context,
+            States {
+                baseline: &self.baseline,
+                from: b_from,
+                update: &mut self.b_update,
+                to: &mut self.b_to,
+                restored_indices: restored,
+            },
+            clock,
+        );
+        assert_eq!(a.is_err(), error, "native={a:?}");
+        assert_eq!(b.is_err(), error, "Rust={b:?}");
+        assert_eq!(self.a_update, self.b_update);
+        assert_eq!(self.a_to, self.b_to);
+        assert_eq!(self.a.stopped_indices(), self.b.stopped_indices());
+        assert_eq!(
+            format!("{:?}", self.a.retargeted_values()),
+            format!("{:?}", self.b.retargeted_values())
+        );
+        compare_tracks(&self.a, &self.b);
+        self.events();
+    }
+    fn tick(&mut self, prior: f32, next: f32) {
+        self.capture(
+            Clock {
+                prior_time: prior,
+                next_time: next,
+                next_seconds: f64::from(next),
+            },
+            &[],
+            false,
+        )
+    }
+    fn sample(&self, second: f64) -> (Vec<State>, Vec<(usize, Target, Update)>) {
+        let mut a = self.a_to.clone();
+        let mut b = self.b_to.clone();
+        let mut aw = Vec::new();
+        let mut bw = Vec::new();
+        self.a
+            .sample_schedule(&mut a, second, |i, t, v| {
+                aw.push((i, t, v.clone()));
+                Ok(())
+            })
+            .unwrap();
+        self.b
+            .sample_schedule(&mut b, second, |i, t, v| {
+                bw.push((i, t, v.clone()));
+                Ok(())
+            })
+            .unwrap();
+        assert_eq!(a, b);
+        assert_eq!(format!("{aw:?}"), format!("{bw:?}"));
+        assert_eq!(
+            self.a.pending_updates(second),
+            self.b.pending_updates(second)
+        );
+        (b, bw)
+    }
+}
+fn compare_tracks(a: &Capture, b: &Capture) {
+    assert_eq!(a.tracks().len(), b.tracks().len());
+    for (a, b) in a.tracks().iter().zip(b.tracks()) {
+        assert_eq!((a.overlay_index, a.target), (b.overlay_index, b.target));
+        assert_eq!(a.samples.len(), b.samples.len());
+        for (a, b) in a.samples.iter().zip(&b.samples) {
+            assert_eq!(a.time.to_bits(), b.time.to_bits());
+            assert_eq!(format!("{:?}", a.value), format!("{:?}", b.value));
+            if let (Update::F32(a), Update::F32(b)) = (&a.value, &b.value) {
+                assert_eq!(a.to_bits(), b.to_bits())
+            }
+        }
+    }
+}
