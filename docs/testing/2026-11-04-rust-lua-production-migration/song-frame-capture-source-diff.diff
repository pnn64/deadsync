+        let b_from = self.b_to.clone();
+        self.capture_from(clock, restored, error, &a_from, &b_from);
+    }
+    fn capture_from(
+        &mut self,
+        clock: Clock,
+        restored: &[usize],
+        error: bool,
+        a_from: &[State],
+        b_from: &[State],
+    ) {
+        let a = test_support::legacy_capture_song_overlay_frame(
+            &self.native,
+            &mut self.a,
