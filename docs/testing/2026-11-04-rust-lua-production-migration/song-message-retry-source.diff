+type MessageRows = Vec<Vec<deadsync_song_lua::SongLuaOverlayMessageCommand>>;
+fn compare_stable_message_pass(pair: &mut Pair, keys: &[&str]) -> (MessageRows, Vec<String>) {
+    let (mut a, mut b) = (Vec::new(), Vec::new());
+    for key in keys {
+        let (x, y) = saved_pair(pair, key);
+        a.push(x);
+        b.push(Value::Table(y));
+    }
+    let (mut expected, mut actual) = (vec![Vec::new(); keys.len()], vec![Vec::new(); keys.len()]);
+    let (mut na, mut rb) = (Vec::new(), Vec::new());
+    let er = test_support::legacy_capture_stable_messages(
+        &pair.native,
+        &mut a
+            .into_iter()
+            .zip(expected.iter_mut())
+            .map(|(actor, commands)| test_support::LegacyMessageTarget { actor, commands })
+            .collect::<Vec<_>>(),
+        |d| na.push(d),
+    );
+    let ar = pair.rust.capture_song_stable_cross_actor_message_commands(
+        &mut b
+            .into_iter()
+            .zip(actual.iter_mut())
+            .map(
+                |(actor, commands)| deadsync_song_lua::rust_engine::SongMessageTarget {
+                    actor,
+                    commands,
+                },
+            )
+            .collect::<Vec<_>>(),
+        |d| rb.push(d),
+    );
+    assert_eq!(ar.is_err(), er.is_err(), "native={er:?}, Rust={ar:?}");
+    assert_eq!(actual, expected);
+    assert_eq!(rb.len(), na.len(), "native={na:?}, Rust={rb:?}");
+    pair.compare();
+    (actual, rb)
+}
+struct DeferredPass {
+    overlays: MessageRows,
+    tracked: MessageRows,
+    sounds: Vec<(usize, String, std::path::PathBuf)>,
+    skipped: Vec<String>,
+    failed: bool,
+}
+fn compare_deferred_message_pass(
+    pair: &mut Pair,
+    keys: &[&str],
+    tracked: &[&str],
+    runtime: &[deadsync_song_lua::SongLuaStatefulMessageCapture],
+) -> DeferredPass {
+    let mut native_skipped = test_support::legacy_deferred_actor_messages(&pair.native)
+        .into_iter()
+        .map(|r| r.2)
+        .collect::<Vec<_>>();
+    let mut rust_skipped = test_support::rust_deferred_actor_messages(&pair.rust)
+        .into_iter()
+        .map(|r| r.2)
+        .collect::<Vec<_>>();
+    native_skipped.push("unrelated detail".into());
+    rust_skipped.push("unrelated detail".into());
+    let mut native = Vec::new();
+    let mut rust = Vec::new();
+    for key in keys.iter().chain(tracked) {
+        let (a, b) = saved_pair(pair, key);
+        native.push(a);
+        rust.push(Value::Table(b));
+    }
+    let (mut expected, mut actual) = (vec![Vec::new(); native.len()], vec![Vec::new(); rust.len()]);
+    let mut native_targets = native
+        .into_iter()
+        .zip(expected.iter_mut())
+        .map(|(actor, commands)| test_support::LegacyMessageTarget { actor, commands })
+        .collect::<Vec<_>>();
+    let mut rust_targets = rust
+        .into_iter()
+        .zip(actual.iter_mut())
+        .map(
+            |(actor, commands)| deadsync_song_lua::rust_engine::SongMessageTarget {
+                actor,
+                commands,
+            },
+        )
+        .collect::<Vec<_>>();
+    let (a, b) = native_targets.split_at_mut(keys.len());
+    let er = test_support::legacy_capture_deferred_messages(
+        &pair.native,
+        a,
+        b,
+        runtime,
+        &mut native_skipped,
+    );
+    let (a, b) = rust_targets.split_at_mut(keys.len());
+    let ar = pair
+        .rust
+        .capture_song_deferred_messages(a, b, runtime, &mut rust_skipped);
+    assert_eq!(ar.is_err(), er.is_err(), "native={er:?}, Rust={ar:?}");
+    assert_eq!(actual, expected);
+    assert_eq!(rust_skipped.len(), native_skipped.len());
+    let failed = ar.is_err();
+    let sounds = ar.unwrap_or_default();
+    assert_eq!(sounds, er.unwrap_or_default());
+    assert!(test_support::rust_deferred_actor_messages(&pair.rust).is_empty());
+    assert!(test_support::legacy_deferred_actor_messages(&pair.native).is_empty());
+    pair.compare();
+    let tracked = actual.split_off(keys.len());
+    DeferredPass {
+        overlays: actual,
+        tracked,
+        sounds,
+        skipped: rust_skipped,
+        failed,
+    }
+}
