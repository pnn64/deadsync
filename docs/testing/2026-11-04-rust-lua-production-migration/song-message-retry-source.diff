+    rust_command_script(
+        &mut runtime,
+        "message_weak=setmetatable({root},{__mode='v'});root=nil;return ''",
+    )
+    .unwrap();
+    runtime.retire_actor_scene(scene).unwrap();
+    rust_command_script(
+        &mut runtime,
+        "collectgarbage();collectgarbage();assert(message_weak[1]);return ''",
