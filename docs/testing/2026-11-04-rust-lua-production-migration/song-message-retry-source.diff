+/// Borrowed native output used only by migration comparisons.
+pub struct LegacyMessageTarget<'a> {
+    pub actor: mlua::Table,
+    pub commands: &'a mut Vec<crate::SongLuaOverlayMessageCommand>,
+}
+fn legacy_message_overlays(
+    targets: &[LegacyMessageTarget<'_>],
+) -> Vec<crate::lua_util::SongLuaOverlayCompileActor<()>> {
+    targets
+        .iter()
+        .map(|r| crate::lua_util::SongLuaOverlayCompileActor {
+            table: r.actor.clone(),
+            actor: crate::SongLuaOverlayActor {
+                kind: (),
+                name: None,
+                parent_index: None,
+                initial_state: Default::default(),
+                message_commands: r.commands.clone(),
+            },
+            message_sounds: Vec::new(),
+        })
+        .collect()
+}
+pub fn legacy_capture_stable_messages(
+    lua: &mlua::Lua,
+    targets: &mut [LegacyMessageTarget<'_>],
+    on_dynamic: impl FnMut(String),
+) -> Result<(), String> {
+    let mut overlays = legacy_message_overlays(targets);
+    let result = crate::lua_util::capture_stable_cross_actor_message_commands(
+        lua,
+        &mut overlays,
+        on_dynamic,
+    );
+    for (target, overlay) in targets.iter_mut().zip(overlays) {
+        *target.commands = overlay.actor.message_commands;
+    }
+    result
+}
+pub fn legacy_capture_deferred_messages(
+    lua: &mlua::Lua,
+    targets: &mut [LegacyMessageTarget<'_>],
+    tracked: &mut [LegacyMessageTarget<'_>],
+    runtime_captures: &[crate::SongLuaStatefulMessageCapture],
+    skipped: &mut Vec<String>,
+) -> Result<Vec<(usize, String, std::path::PathBuf)>, String> {
+    let mut overlays = legacy_message_overlays(targets);
+    let mut tracked_actors = tracked
+        .iter()
+        .map(|r| crate::SongLuaTrackedActor {
+            table: r.actor.clone(),
+            actor: crate::SongLuaCapturedActor {
+                message_commands: r.commands.clone(),
+                ..Default::default()
+            },
+            target: crate::SongLuaTrackedActorTarget::Player(0),
+        })
+        .collect::<Vec<_>>();
+    let result = crate::lua_util::capture_deferred_messages(
+        lua,
+        &mut overlays,
+        &mut tracked_actors,
+        runtime_captures,
+        skipped,
+    );
+    for (target, overlay) in targets.iter_mut().zip(overlays) {
+        *target.commands = overlay.actor.message_commands;
+    }
+    for (target, actor) in tracked.iter_mut().zip(tracked_actors) {
+        *target.commands = actor.actor.message_commands;
+    }
+    result
+}
