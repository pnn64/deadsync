+        setmetatable(a,{__index=mt.__index,__newindex=function(t,k,v)
+            if k=='Text' then collectgarbage();collectgarbage();assert(probe_weak[1] and probe_weak[1].marker=='first');assert(probe_weak[2]==nil);log('retained',v)end
