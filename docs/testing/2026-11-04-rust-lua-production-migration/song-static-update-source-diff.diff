+        );
+        assert_eq!(rust.is_err(), error, "Rust: {:?}", rust.as_ref().err());
+        self.events();
+        match (native, rust) {
+            (Ok(native), Ok(rust)) => {
+                compare_output(&native, &rust);
+                Some(rust)
+            }
+            _ => None,
+        }
+    }
+}
+fn compare_output(a: &SongStaticUpdateOutput, b: &SongStaticUpdateOutput) {
+    assert_eq!(a.eases, b.eases);
+    for (a, b) in a.eases.iter().zip(&b.eases) {
+        assert_eq!(
+            [
+                a.start.to_bits(),
+                a.limit.to_bits(),
+                a.from.to_bits(),
+                a.to.to_bits()
+            ],
+            [
+                b.start.to_bits(),
+                b.limit.to_bits(),
+                b.from.to_bits(),
+                b.to.to_bits()
+            ]
+        );
+        assert_eq!(
+            a.approach_speed.map(f32::to_bits),
+            b.approach_speed.map(f32::to_bits)
+        );
+    }
+    assert_eq!(a.column_transforms, b.column_transforms);
+    for (a, b) in a.column_transforms.iter().zip(&b.column_transforms) {
+        assert_eq!(
+            [
+                a.start.to_bits(),
+                a.limit.to_bits(),
+                a.from_y.to_bits(),
+                a.to_y.to_bits()
+            ],
+            [
+                b.start.to_bits(),
+                b.limit.to_bits(),
+                b.from_y.to_bits(),
+                b.to_y.to_bits()
+            ]
+        );
+    }
+    assert_eq!(a.column_splines.len(), b.column_splines.len());
+    for (a, b) in a.column_splines.iter().zip(&b.column_splines) {
+        assert_eq!(
+            (a.player, a.column, a.time_offset.to_bits()),
+            (b.player, b.column, b.time_offset.to_bits())
+        );
+        assert_eq!(a.frames.len(), b.frames.len());
+        for (a, b) in a.frames.iter().zip(b.frames.iter()) {
+            assert_eq!(a.second.to_bits(), b.second.to_bits());
+            for (a, b) in [(&a.position, &b.position), (&a.zoom, &b.zoom)] {
+                assert_eq!(a.is_some(), b.is_some());
+                if let (Some(a), Some(b)) = (a, b) {
+                    assert_eq!(a.constant, b.constant);
+                    assert_eq!(
+                        (
+                            a.beats_per_t.to_bits(),
+                            a.receptor_t.to_bits(),
+                            a.looping,
+                            a.subtract_song_beat
+                        ),
+                        (
+                            b.beats_per_t.to_bits(),
+                            b.receptor_t.to_bits(),
+                            b.looping,
+                            b.subtract_song_beat
+                        )
+                    );
+                    assert_eq!(a.coefficients.len(), b.coefficients.len());
+                    for (a, b) in a
+                        .coefficients
+                        .iter()
+                        .flatten()
+                        .flatten()
+                        .zip(b.coefficients.iter().flatten().flatten())
+                    {
+                        assert_eq!(a.to_bits(), b.to_bits());
+                    }
+                }
+            }
+        }
+    }
+}
+fn compare_states(a: &[SongLuaUpdateModState; 2], b: &[SongLuaUpdateModState; 2]) {
+    for (a, b) in a.iter().zip(b) {
+        assert_eq!(a.keys().collect::<Vec<_>>(), b.keys().collect::<Vec<_>>());
+        for (name, a) in a {
+            assert_eq!(a.to_bits(), b[name].to_bits(), "{name}");
+        }
+    }
+}
