+        let native: String = self
+            .native
+            .load("return table.concat(events,'|')")
+            .eval()
+            .unwrap();
+        let Value::String(id) = self
+            .rust
+            .vm_mut()
+            .execute(&compile_named(b"return table.concat(events,'|')", b"=events").unwrap())
+            .unwrap()[0]
+        else {
+            panic!()
+        };
+        assert_eq!(
+            native.as_bytes(),
+            self.rust.vm_mut().string_bytes(id).unwrap()
+        );
+        native
+    }
