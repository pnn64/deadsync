+    );
+    compare_indexed_actor_capture(&mut pair, &[(0, "a")], None, Some(8.), false, true).unwrap();
+    pair.script(
+        "collectgarbage();collectgarbage();assert(probe_weak[1]==nil);log(saved.a:GetText())",
+    );
+    assert_eq!(pair.compare(), "retained,original|original");
+}

