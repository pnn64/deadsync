+fn compare_indexed_actor_capture(
+    pair: &mut Pair,
+    selected: &[(usize, &str)],
+    arg: Option<f32>,
+    beat: Option<f32>,
+    error: bool,
+    emptied: bool,
+) -> Option<deadsync_song_lua::rust_engine::SongActorFunctionBlocks> {
+    let mut native = Vec::new();
+    let mut rust = Vec::new();
+    for &(index, key) in selected {
+        let (a, b) = saved_pair(pair, key);
+        native.push((index, a));
+        rust.push((index, Value::Table(b)));
+    }
+    let f: mlua::Function = pair.native.globals().get("indexed_probe").unwrap();
+    let g = pair.rust.vm_mut().get_global(b"indexed_probe").unwrap();
+    let expected =
+        test_support::legacy_capture_indexed_actor_function(&pair.native, &native, &f, arg, beat);
+    let actual = pair.rust.capture_song_actor_function(&rust, g, arg, beat);
+    assert_eq!(
+        expected.is_err(),
+        error,
+        "native capture error: {expected:?}"
+    );
+    assert_eq!(actual.is_err(), error, "Rust capture error: {actual:?}");
+    assert_eq!(
+        pair.rust.values().unwrap(),
+        deadsync_song_lua::compile_song_runtime_values(&pair.native).unwrap()
+    );
+    if emptied {
+        for ((_, a), (_, b)) in native.iter().zip(&rust) {
+            assert!(test_support::legacy_captured_blocks(a).unwrap().is_empty());
+            assert!(
+                pair.rust
+                    .actor_command_capture(*b)
+                    .unwrap()
+                    .blocks
+                    .is_empty()
+            );
+        }
+    }
+    pair.compare();
+    if error {
+        None
+    } else {
+        let expected = expected.unwrap();
+        let actual = actual.unwrap();
+        assert_eq!(actual, expected);
+        Some(actual)
+    }
