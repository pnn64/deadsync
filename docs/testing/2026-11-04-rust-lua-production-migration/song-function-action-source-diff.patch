+                .iter()
+                .map(|(i, _)| *i)
+                .collect::<Vec<_>>(),
+            [7, 7, 2]
+        );
+        assert_eq!(
+            output
+                .tracked_blocks
+                .iter()
+                .map(|(i, _)| *i)
+                .collect::<Vec<_>>(),
+            [0, 1, 2]
+        );
+        assert_eq!(
+            output.broadcasts,
+            [("Suppressed".into(), false), ("Delivered".into(), true)]
+        );
+        assert_eq!(output.sound_paths, [sound.clone(), sound.clone()]);
+        assert_eq!(output.side_effects, 4);
