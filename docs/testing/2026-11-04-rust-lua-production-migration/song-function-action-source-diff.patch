+fn compare_function_action(
+    pair: &mut Pair,
+    overlays: &[(usize, &str)],
+    tracked: &[&str],
+    beat: f32,
+) -> Result<deadsync_song_lua::SongLuaFunctionActionCapture, (String, String)> {
+    let mut native = Vec::new();
+    let mut rust = Vec::new();
+    for &(index, key) in overlays {
+        let (a, b) = saved_pair(pair, key);
+        native.push((index, a));
+        rust.push((index, Value::Table(b)));
+    }
+    let mut native_tracked = Vec::new();
+    let mut rust_tracked = Vec::new();
+    for key in tracked {
+        let (a, b) = saved_pair(pair, key);
+        native_tracked.push(a);
+        rust_tracked.push(Value::Table(b));
+    }
+    let f: mlua::Function = pair.native.globals().get("action_probe").unwrap();
+    let g = pair.rust.vm_mut().get_global(b"action_probe").unwrap();
+    let expected = test_support::legacy_capture_function_action(
+        &pair.native,
+        &native,
+        &native_tracked,
+        &f,
+        beat,
+    );
+    let actual = pair
+        .rust
+        .capture_song_function_action(&rust, &rust_tracked, g, beat);
+    assert_eq!(
+        actual.is_err(),
+        expected.is_err(),
+        "native={expected:?}, Rust={actual:?}"
+    );
+    assert_eq!(
+        pair.rust.values().unwrap(),
+        deadsync_song_lua::compile_song_runtime_values(&pair.native).unwrap()
+    );
+    pair.compare();
+    match (expected, actual) {
+        (Ok(expected), Ok(actual)) => {
+            assert_eq!(actual, expected);
+            Ok(actual)
+        }
+        (Err(a), Err(b)) => Err((a, b)),
+        _ => unreachable!(),
+    }
+}
