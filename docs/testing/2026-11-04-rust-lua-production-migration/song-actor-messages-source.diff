+fn compare_actor_command(
+    pair: &mut Pair,
+    key: &str,
+    name: &str,
+) -> Result<Vec<deadsync_song_lua::SongLuaOverlayCommandBlock>, (String, String)> {
+    let (a, b) = saved_pair(pair, key);
+    let expected = test_support::legacy_capture_actor_command(&pair.native, &a, name);
+    let actual = pair.rust.capture_song_actor_command(Value::Table(b), name);
+    assert_eq!(
+        expected.is_err(),
+        actual.is_err(),
+        "native={expected:?}, Rust={actual:?}"
+    );
+    pair.compare();
+    match (expected, actual) {
+        (Ok(a), Ok(b)) => {
+            assert_eq!(a, b);
+            Ok(b)
+        }
+        (Err(a), Err(b)) => Err((a, b)),
+        _ => unreachable!(),
+    }
+}
+fn compare_actor_messages(
+    pair: &mut Pair,
+    key: &str,
+) -> deadsync_song_lua::SongLuaCapturedMessageCommands {
+    let (a, b) = saved_pair(pair, key);
+    let expected = test_support::legacy_capture_actor_messages(&pair.native, &a).unwrap();
+    let actual = pair
+        .rust
+        .capture_song_actor_message_commands(Value::Table(b))
+        .unwrap();
+    assert_eq!(expected.commands, actual.commands);
+    assert_eq!(expected.sounds, actual.sounds);
+    assert_eq!(expected.skipped.len(), actual.skipped.len());
+    pair.compare();
+    actual
+}
