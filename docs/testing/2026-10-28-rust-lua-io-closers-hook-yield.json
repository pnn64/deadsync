  "source": "local file=assert(io.tmpfile());local original=debug.getfenv(file)\nlocal closer=m.file_closer('yield-zero',false);debug.setfenv(file,{__close=closer})\nlocal fn=function(f)return 17 end;debug.setfenv(fn,{marker='Lua activation'})\nlocal co=coroutine.create(fn);m.file_hook(io.close,fn,co)\nlocal function pack(...)return{n=select('#',...),...}end\nlocal function emit(label,r)\n  print(label,r.n)\n  for i=1,r.n do local v=r[i];if rawequal(v,co)then print('value',i,'thread:self')\n  elseif type(v)=='string'then print('value',i,'string',v:gsub('.',function(c)return('%02x'):format(c:byte())end))\n  elseif type(v)=='number'or type(v)=='boolean'or v==nil then print('value',i,type(v),tostring(v))\n  else print('value',i,type(v))end end\nend\nlocal first=pack(coroutine.resume(co,file));debug.setfenv(file,original)\nemit('first',first);print('status',coroutine.status(co))\nemit('second',pack(coroutine.resume(co)));print('status',coroutine.status(co))\nif io.type(file)=='file'then assert(file:close())end\nprint('usable',17+29)\n",
