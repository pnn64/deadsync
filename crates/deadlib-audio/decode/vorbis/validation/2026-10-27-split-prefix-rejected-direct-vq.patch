--- a/crates/deadlib-audio/decode/vorbis/src/codebook.rs
+++ b/crates/deadlib-audio/decode/vorbis/src/codebook.rs
@@ -389 +389,6 @@ impl Codebook {
-        self.vector(self.decode_scalar(bits)?)
+        // A successful Huffman result is an active entry in this immutable
+        // book. The parser allocated a vector for every entry; the public
+        // random-entry accessor still validates caller-supplied indices.
+        let entry = self.decode_scalar(bits)? as usize;
+        let start = entry * self.dimensions();
+        Ok(&self.vectors[start..start + self.dimensions()])
