@@ -202,0 +212,42 @@ fn mixed_lookahead_and_reads_preserve_cache_carries_and_every_packet_tail() {
+#[test]
+fn direct_vq_decode_matches_checked_scalar_and_vector_at_every_tail() {
+    for lengths in [[2; 4], [0, 1, 0, 1], [0, 0, 0, 1], [1, 2, 3, 3]] {
+        for lookup in 0..=2 {
+            for sequence in [false, true] {
+                let wire = packed_book_lengths(lookup, sequence, &lengths);
+                let book = Codebook::read(&mut BitReader::new(&wire), &Limits::default()).unwrap();
+                for first in 0..=255u8 {
+                    let bytes = [first, 0xa5, 0x80, 0xff];
+                    for length in 0..=bytes.len() {
+                        for alignment in 0..8 {
+                            let mut actual = BitReader::new(&bytes[..length]);
+                            let mut expected = actual.clone();
+                            let _ = actual.read(alignment);
+                            let _ = expected.read(alignment);
+                            for _ in 0..12 {
+                                let reference = if lookup == 0 {
+                                    // VQ requires a lookup before reading any
+                                    // codeword, including after exhaustion.
+                                    book.vector(0)
+                                } else {
+                                    book.decode_scalar(&mut expected)
+                                        .and_then(|entry| book.vector(entry))
+                                };
+                                assert_eq!(book.decode_vector(&mut actual), reference);
+                                assert_eq!(
+                                    (actual.position(), actual.remaining(), actual.is_exhausted()),
+                                    (
+                                        expected.position(),
+                                        expected.remaining(),
+                                        expected.is_exhausted()
+                                    )
+                                );
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
