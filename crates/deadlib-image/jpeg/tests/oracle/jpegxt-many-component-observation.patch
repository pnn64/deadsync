+
+// Test-only read-only observation of entropy-decoded visible blocks.
+void BlockBuffer::ObserveDecoded(void) const
+{
+  const char *path = std::getenv("DEADLIB_JPEG_FRAME_DUMP");
+  FILE *dump = path ? std::fopen(path,"a") : NULL;
+  if (!dump) return;
+  ULONG mh = 0,mv = 0;
+  for(unsigned i = 0;i < m_ucCount;i++) {
+    class Component *c = m_pFrame->ComponentOf(i);
+    if (c->MCUWidthOf() > mh) mh = c->MCUWidthOf();
+    if (c->MCUHeightOf() > mv) mv = c->MCUHeightOf();
+  }
+  for(unsigned i = 0;i < m_ucCount;i++) {
+    class Component *c = m_pFrame->ComponentOf(i);
+    ULONG w = (m_pFrame->WidthOf() * c->MCUWidthOf() + mh - 1) / mh;
+    ULONG h = (m_pFrame->HeightOf() * c->MCUHeightOf() + mv - 1) / mv;
+    class QuantizedRow *row = m_ppQTop[i];
+    for(ULONG y = 0;y < (h + 7) / 8 && row;y++,row = row->NextOf()) {
+      for(ULONG x = 0;x < (w + 7) / 8;x++) {
+        const LONG *src = row->BlockAt(x)->m_Data;
+        std::fprintf(dump,"D %d %lu %lu %u",int(m_pFrame->ScanTypeOf()),m_pFrame->WidthOf(),m_pFrame->HeightOf(),unsigned(c->IDOf()));
+        for(unsigned k = 0;k < 64;k++) std::fprintf(dump," %ld",src[k]);
+        std::fprintf(dump,"\n");
+      }
+    }
+  }
+  std::fclose(dump);
+}
 
