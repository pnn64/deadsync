+  }
+  for(unsigned i = 0;i < m_ucCount;i++) {
+    class Component *c = m_pFrame->ComponentOf(i);
+    ULONG w = (m_pFrame->WidthOf() * c->MCUWidthOf() + mh - 1) / mh;
