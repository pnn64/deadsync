+#[cfg(test)]
+fn check_avx2_adler(input: &[u8], initial: (u32, u32), split: usize) {
+    assert!(
+        std::is_x86_feature_detected!("avx2"),
+        "AVX2 validation must execute; for Miri set RUSTFLAGS=-C target-feature=+avx2"
+    );
+    // A byte-at-a-time modular oracle has no SIMD grouping or deferred sums.
+    let (mut a, mut b) = (u64::from(initial.0), u64::from(initial.1));
+    for &byte in input {
+        a = (a + u64::from(byte)) % 65521;
+        b = (b + a) % 65521;
+    }
+    let expected = (a as u32, b as u32);
+    let mut actual = super::Adler32 {
+        a: initial.0,
+        b: initial.1,
+    };
+    // SAFETY: AVX2 was asserted above. All loads use checked byte arrays.
+    unsafe {
+        adler_avx2(&mut actual, input);
+    }
+    assert_eq!(
+        (actual.a, actual.b),
+        expected,
+        "len={} initial={initial:?}",
+        input.len()
+    );
+    let mut fragmented = super::Adler32 {
+        a: initial.0,
+        b: initial.1,
+    };
+    // SAFETY: AVX2 was asserted above; arbitrary slice lengths are supported.
+    unsafe {
+        adler_avx2(&mut fragmented, &input[..split]);
+        adler_avx2(&mut fragmented, &input[split..]);
+    }
+    assert_eq!(
+        (fragmented.a, fragmented.b),
+        expected,
+        "len={} initial={initial:?} split={split}",
+        input.len()
+    );
+    let mut dispatched = super::Adler32 {
+        a: initial.0,
+        b: initial.1,
+    };
+    let used = adler_update(&mut dispatched, input);
+    assert_eq!(used, input.len() >= 128);
+    assert_eq!(
+        (dispatched.a, dispatched.b),
+        if used { expected } else { initial }
+    );
+}
