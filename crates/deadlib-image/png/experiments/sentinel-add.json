  "change": "Marker-bit decoder reservoir with one-shift arithmetic refill. The old marker contributes 2^count; adding (input + 2^width - 1) << count replaces it with the new data plus marker at count+width. Refill widths/conditions, error behavior and encoder bit writing are unchanged.",
  "reservoir_invariant": {
    "representation": "word = data + 2^count, with 0 <= data < 2^count; empty word = 1",
    "availability": "word >= 2^n iff count >= n",
    "refill": "word + ((input + 2^width - 1) << count) = data + (input << count) + 2^(count+width)",
    "refill_bounds": "Byte refill starts below n <= 32, so count+8 <= 39. Wide Huffman refill starts below n <= 15, so count+32 <= 46. Every refill fits below bit 47.",
    "primary_consumption": "remaining = (word >> 1) >> ((n-1) mod 64). For primary lengths 1..9, remaining is nonzero iff count >= n. A table miss n=0 always gives zero because (word >> 1) >> 63 = 0.",
    "partial_lookup": "A marker within the nine-bit table index cannot affect any complete code whose width is at most count; incomplete lookups reject before changing the reservoir. Canonical fallback checks only the available low bits.",
    "consumed_bytes": "pos - floor(count / 8); retain virtual count-64 arithmetic coverage independently of representable marker states 0..63."
  }
}
