+fn pack_bits<const DEPTH: u8>(samples: &[u8], row: &mut [u8]) {
+    for (out, values) in row.iter_mut().zip(samples.chunks(8 / DEPTH as usize)) {
+        let mut byte = 0;
+        for (n, &value) in values.iter().enumerate() {
+            byte |= value << (8 - DEPTH - n as u8 * DEPTH);
+        }
+        *out = byte;
+    }
+}
