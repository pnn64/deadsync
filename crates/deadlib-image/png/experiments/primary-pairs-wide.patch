+// Buffered-only twelve-bit literal lookahead. Incremental decoding retains
+// its original nine-bit tables and fixed working-memory contract.
+struct BufferedLiterals {
+    tree: Huffman,
+    fast: [u32; 4096],
+}
+impl BufferedLiterals {
+    fn new(tree: Huffman) -> Self {
+        let mut fast = [0; 4096];
+        for n in 1..=usize::from(tree.max.min(12)) {
+            for offset in 0..tree.counts[n] {
+                let code = tree.first[n] + offset;
+                let reverse = usize::from(code.reverse_bits() >> (16 - n));
+                let symbol = tree.symbols[usize::from(tree.offsets[n] + offset)];
+                for prefix in (reverse..4096).step_by(1 << n) {
+                    fast[prefix] = (u32::from(symbol) << 4) | n as u32;
+                }
+            }
+        }
+        if tree.counts[1..=6].iter().any(|&n| n != 0) {
+            for prefix in 0..4096 {
+                let entry = fast[prefix];
+                let n = entry & 15;
+                if n != 0 && entry >> 4 < 256 {
+                    let next = fast[prefix >> n];
+                    // Earlier prefixes are already paired. Preserve their
+                    // original first-code width for this in-place pass.
+                    let m = if next & (1 << 21) != 0 {
+                        (next >> 22) & 15
+                    } else {
+                        next & 15
+                    };
+                    let symbol = (next >> 4) & 511;
+                    if m != 0 && n + m <= 12 && symbol < 256 {
+                        fast[prefix] =
+                            (1 << 21) | (n << 22) | (symbol << 13) | ((entry >> 4) << 4) | (n + m);
+                    }
+                }
+            }
+        }
+        Self { tree, fast }
+    }
+    #[inline]
+    fn decode(&self, bits: &mut Bits<'_>) -> Result<usize, Error> {
+        bits.fill_huffman(12);
+        let entry = self.fast[(bits.word & 4095) as usize];
+        let n = (entry & 15) as u8;
+        if n != 0 && n <= bits.count {
+            bits.word >>= n;
+            bits.count -= n;
+            return Ok((entry >> 4) as usize);
+        }
+        // Near EOF the first literal can fit even when a pair does not.
+        self.tree.decode(bits)
+    }
+}
