+fn unpack<const DEPTH: u8>(row: &[u8], out: &mut [u8]) {
+    for (samples, &byte) in out.chunks_mut(8 / DEPTH as usize).zip(row) {
+        for (n, sample) in samples.iter_mut().enumerate() {
+            *sample = (byte >> (8 - DEPTH - n as u8 * DEPTH)) & ((1 << DEPTH) - 1);
+        }
+    }
 }
 
