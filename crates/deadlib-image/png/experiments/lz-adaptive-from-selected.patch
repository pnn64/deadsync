+            reserve(&mut history, BLOCK)?;
+            history.resize(BLOCK, 0);
+            matcher = Some(matcher::Matcher::new()?);
+            tokens = Some(Tokens::new()?);
+        }
+        Ok(Self {
+            mode,
+            writer: Writer {
+                bytes,
+                word: 0,
+                count: 0,
+            },
+            pending: 0,
+            block,
+            history,
+            matcher,
+            tokens,
+            encoded: 0,
+            total_in: 0,
+            total_out: 0,
+            checksum: Adler32::new(),
+            finishing: false,
+            done: false,
+            failure: None,
