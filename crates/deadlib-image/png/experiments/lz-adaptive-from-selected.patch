+impl Deflater {
+    pub fn new(mode: Compression) -> Result<Self, Error> {
+        let mut bytes = Vec::new();
+        reserve(&mut bytes, BLOCK * 9 / 8 + 64)?;
+        bytes.extend_from_slice(&[0x78, 0x01]);
