+    mode: Compression,
+    writer: Writer,
+    pending: usize,
+    block: Vec<u8>,
+    history: Vec<u8>,
+    matcher: Option<matcher::Matcher>,
+    tokens: Option<Tokens>,
+    encoded: usize,
+    total_in: usize,
+    total_out: usize,
+    checksum: Adler32,
+    finishing: bool,
+    done: bool,
+    failure: Option<Error>,
