+#[inline]
+fn palette_rgba(png: &Png, index: usize) -> [u16; 4] {
+    let Some(&[r, g, b]) = png.palette.get(index) else {
+        return [0, 0, 0, 65535];
+    };
+    let a = match &png.transparency {
+        Some(Transparency::Palette(v)) => v.get(index).copied().unwrap_or(255),
+        _ => 255,
+    };
+    [
+        u16::from(r) * 257,
+        u16::from(g) * 257,
+        u16::from(b) * 257,
+        u16::from(a) * 257,
+    ]
+}
