+// The buffered loop needs values and extra-bit counts, rather than symbol
+// numbers. Decode them into its primary entries once per block. Streaming
+// keeps its compact symbol tables and fixed working-memory contract.
+struct BufferedHuffman {
+    tree: Huffman,
+    fast: [u32; 512],
+    distance: bool,
+}
+impl BufferedHuffman {
+    fn value(symbol: usize, distance: bool) -> u32 {
+        if distance {
+            if symbol >= 30 {
+                return 0;
+            }
+            (DIST_BASE[symbol] as u32) << 4 | u32::from(DIST_EXTRA[symbol])
+        } else {
+            match symbol {
+                0..=256 => symbol as u32,
+                257..=285 => {
+                    let index = symbol - 257;
+                    (LENGTH_BASE[index] as u32) << 13 | u32::from(LENGTH_EXTRA[index]) << 10
+                }
+                _ => 257,
+            }
+        }
+    }
+    fn new(tree: Huffman, distance: bool) -> Self {
+        let fast = core::array::from_fn(|index| {
+            let entry = tree.fast[index];
+            Self::value((entry >> 4) as usize, distance) << 4 | u32::from(entry & 15)
+        });
+        Self {
+            tree,
+            fast,
+            distance,
+        }
+    }
+    #[inline]
+    fn decode(&self, bits: &mut Bits<'_>) -> Result<u32, Error> {
+        bits.fill_huffman(9);
+        let entry = self.fast[(bits.word & 511) as usize];
+        let n = (entry & 15) as u8;
+        if n != 0 && n <= bits.count {
+            bits.word >>= n;
+            bits.count -= n;
+            return Ok(entry >> 4);
+        }
+        Ok(Self::value(self.tree.decode_slow(bits)?, self.distance))
+    }
+}
