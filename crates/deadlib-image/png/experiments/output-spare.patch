+// Decode into already allocated, initialized spare capacity. A full DEFLATE
+// match is at most 258 bytes, so the slice bound subsumes per-token output
+// budget/capacity checks. `written` separates history from the writable tail.
+fn inflate_spare(
+    lit: &Huffman,
+    dist: &Huffman,
+    bits: &mut Bits<'_>,
+    output: &mut [u8],
+    mut written: usize,
+    window: usize,
+) -> Result<(usize, bool), Error> {
+    while output.len() - written >= 258 {
+        match lit.decode(bits)? {
+            literal @ 0..=255 => {
+                output[written] = literal as u8;
+                written += 1;
+            }
+            256 => return Ok((written, true)),
+            symbol @ 257..=285 => {
+                let index = symbol - 257;
+                let len = LENGTH_BASE[index] + bits.read(LENGTH_EXTRA[index])? as usize;
+                let symbol = dist.decode(bits)?;
+                if symbol >= 30 {
+                    return Err(Error::Invalid("reserved distance symbol"));
+                }
+                let distance = DIST_BASE[symbol] + bits.read(DIST_EXTRA[symbol])? as usize;
+                if distance > written || distance > window {
+                    return Err(Error::Invalid("distance outside history window"));
+                }
+                let start = written - distance;
+                if distance == 1 {
+                    let value = output[start];
+                    output[written..written + len].fill(value);
+                    written += len;
+                } else {
+                    let mut left = len;
+                    while left != 0 {
+                        let count = (written - start).min(left);
+                        output.copy_within(start..start + count, written);
+                        written += count;
+                        left -= count;
+                    }
+                }
+            }
+            _ => return Err(Error::Invalid("reserved literal symbol")),
+        }
+    }
+    Ok((written, false))
+}
