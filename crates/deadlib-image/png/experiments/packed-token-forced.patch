+// The buffered loop needs values and extra-bit counts, rather than symbol
+// numbers. Decode them into its primary entries once per block. Streaming
+// keeps its compact symbol tables and fixed working-memory contract.
+struct BufferedHuffman {
+    tree: Huffman,
+    fast: [u32; 512],
+    distance: bool,
+}
+impl BufferedHuffman {
+    fn value(symbol: usize, distance: bool) -> u32 {
+        if distance {
+            if symbol >= 30 {
+                return 0;
+            }
+            (DIST_BASE[symbol] as u32) << 4 | u32::from(DIST_EXTRA[symbol])
+        } else {
+            match symbol {
+                0..=256 => (symbol as u32) << 4,
+                257..=285 => {
+                    let index = symbol - 257;
+                    ((LENGTH_BASE[index] as u32 + 512) << 4) | u32::from(LENGTH_EXTRA[index])
+                }
+                _ => 257 << 4,
+            }
+        }
+    }
+    fn new(tree: Huffman, distance: bool) -> Self {
+        let fast = core::array::from_fn(|index| {
+            let entry = tree.fast[index];
+            let n = (entry & 15) as usize;
+            let first = entry >> 4;
+            if !distance && n != 0 && first < 256 {
+                let second = tree.fast[index >> n];
+                let m = (second & 15) as usize;
+                if m != 0 && n + m <= 9 && second >> 4 < 256 {
+                    let pair = 0x1_0000 | u32::from(first) | u32::from(second >> 4) << 8;
+                    return pair << 8 | (n + m) as u32;
+                }
+            }
+            Self::value((entry >> 4) as usize, distance) << 4 | u32::from(entry & 15)
+        });
+        Self {
+            tree,
+            fast,
+            distance,
+        }
+    }
+    #[inline(always)]
+    fn decode(&self, bits: &mut Bits<'_>) -> Result<u32, Error> {
+        bits.fill_buffered();
+        let entry = self.fast[(bits.word & 511) as usize];
+        let n = (entry & 15) as u8;
+        let extra = ((entry >> 4) & 15) as u8;
+        let total = n + extra;
+        if n != 0 && total <= bits.count {
+            let mut value = entry >> 8;
+            if extra != 0 {
+                value += ((bits.word >> n) & ((1u64 << extra) - 1)) as u32;
+            }
+            bits.word >>= total;
+            bits.count -= total;
+            return Ok(value);
+        }
+        self.decode_slow(bits)
+    }
+    #[inline(never)]
+    fn decode_slow(&self, bits: &mut Bits<'_>) -> Result<u32, Error> {
+        let value = Self::value(self.tree.decode(bits)?, self.distance);
+        Ok((value >> 4) + bits.read((value & 15) as u8)?)
+    }
+}
