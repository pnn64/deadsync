*.tsv text eol=lf
*.rs text eol=lf
*.json text eol=lf
independent-build.log text eol=lf
zlib-conformance.log text eol=lf
huffman-conformance.log text eol=lf
inflate-validation.log text eol=lf
huffman-call-*.log text eol=lf
# perf's raw call-chain reports contain intentional trailing alignment spaces.
profiling/*.txt text eol=lf -whitespace
reference-conformance.log text eol=lf
coverage-reports/*.txt text eol=lf
coverage-reports/*.log text eol=lf
tests/fixtures/language/* text eol=lf
src/metadata/language/registry.rs text eol=lf
# Keep raw tool diagnostics, including libFuzzer's intentional trailing spaces.
fuzz/reports/*.log -whitespace
# Checkpoint diffs preserve raw line endings as well as context whitespace.
experiments/*.patch -text -whitespace
